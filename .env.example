# Copy this file to .env and fill in your values

# Flask secret key — change this to a long random string
SECRET_KEY=change-me-to-a-random-secret

# Google Maps API key — enable Maps JavaScript API + Places API + Directions API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here

# Your school's display name shown throughout the app
SCHOOL_NAME=My High School

# Your school's full address (used as default destination when posting rides)
SCHOOL_ADDRESS=1234 School St, City, State 00000
